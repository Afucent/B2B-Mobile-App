# Metro / Expo app port
EXPO_PORT=8081

# Backend API — local dev / expo start (gitignored .env)
EXPO_PUBLIC_API_URL=http://192.168.0.182:8000/api/v1
EXPO_PUBLIC_API_PORT=8000

# EAS cloud APK builds do NOT read .env — set the same URL in eas.json → build.preview.env
# or: eas secret:create --name EXPO_PUBLIC_API_URL --value https://stage-fsa.afbex.com/api/v1
