{
  "expo": {
    "name": "AFBEX",
    "slug": "afbex",
    "version": "2.4.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "afbex",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "AFBEX uses your location to verify clock-in, clock-out, and field tracking."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A3A3A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1A3A3A",
          "image": "./assets/images/splash-afbex.png",
          "imageWidth": 280,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AFBEX uses your location to verify clock-in, clock-out, and field tracking."
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "AFBEX uses photos as proof of dealer visits.",
          "cameraPermission": "AFBEX uses the camera to capture proof of dealer visits."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
